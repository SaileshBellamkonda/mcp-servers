{
  "name": "mcp-servers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A collection of Model Context Protocol (MCP) servers.",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^12.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean"
  },
  "keywords": [],
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@tsconfig/node24": "catalog:",
    "eslint": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:"
  }
}
