{
  "name": "mcp-servers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A collection of Model Context Protocol (MCP) servers.",
  "engines": {
    "node": "^24.11.0",
    "pnpm": "^12.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "error"
    },
    "packageManager": [
      {
        "name": "npm",
        "version": ">=11.0.0",
        "onFail": "error"
      },
      {
        "name": "pnpm",
        "version": "^12.0.0",
        "onFail": "error"
      }
    ]
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean"
  },
  "keywords": [],
  "devDependencies": {
    "@tsconfig/node24": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "vite": "catalog:"
  }
}
