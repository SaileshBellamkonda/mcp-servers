{
  "name": "@mcp-servers/http-host",
  "version": "1.0.0",
  "private": true,
  "description": "Shared, secured Streamable HTTP host for the MCP servers in this repository",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "@mcp-servers/source": "./src/index.ts"
    },
    "./testing": {
      "@mcp-servers/source": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@mcp-servers/common": "workspace:*",
    "@modelcontextprotocol/hono": "2.0.0-alpha.2",
    "@modelcontextprotocol/server": "2.0.0-alpha.2",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
