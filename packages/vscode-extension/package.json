{
  "name": "mcp-servers",
  "displayName": "MCP Servers",
  "description": "Runs Model Context Protocol servers (Git, and CodeRAG semantic search where supported) inside VS Code, bound to loopback and protected by a bearer token.",
  "version": "0.1.0",
  "publisher": "SaileshBellamkonda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaileshBellamkonda/mcp-servers.git",
    "directory": "packages/vscode-extension"
  },
  "homepage": "https://github.com/SaileshBellamkonda/mcp-servers#readme",
  "bugs": {
    "url": "https://github.com/SaileshBellamkonda/mcp-servers/issues"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "git",
    "claude"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22.16"
  },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configuration": {
      "title": "MCP Servers",
      "properties": {
        "mcpServers.git.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Auto-start Git MCP Server on workspace open"
        },
        "mcpServers.git.port": {
          "type": "integer",
          "default": 3000,
          "description": "HTTP port for the Git MCP Server"
        }
      }
    },
    "commands": [
      {
        "command": "mcpServers.startServer",
        "title": "Start Server",
        "category": "MCP Servers"
      },
      {
        "command": "mcpServers.stopServer",
        "title": "Stop Server",
        "category": "MCP Servers"
      },
      {
        "command": "mcpServers.restartServer",
        "title": "Restart Server",
        "category": "MCP Servers"
      },
      {
        "command": "mcpServers.copyServerUrl",
        "title": "Copy Server URL",
        "category": "MCP Servers"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcpServers",
          "title": "MCP Servers",
          "icon": "$(server)"
        }
      ]
    },
    "views": {
      "mcpServers": [
        {
          "id": "mcpServers",
          "name": "MCP Servers"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ../../scripts/bundle-extension.mjs .",
    "stage:native": "node ../../scripts/stage-native.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@mcp-servers/server-coderag": "workspace:*",
    "@mcp-servers/server-git": "workspace:*",
    "@types/node": "catalog:",
    "@types/vscode": "1.101.0",
    "@vitest/coverage-v8": "catalog:",
    "@vscode/vsce": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
