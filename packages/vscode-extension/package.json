{
  "name": "@mcp-servers/vscode-extension",
  "version": "0.1.0",
  "description": "VS Code extension hosting MCP servers",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22.0.0"
  },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configuration": {
      "title": "MCP Servers",
      "properties": {
        "mcpServers.git.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Auto-start Git MCP Server on workspace open"
        },
        "mcpServers.git.port": {
          "type": "integer",
          "default": 3000,
          "description": "HTTP port for the Git MCP Server"
        }
      }
    },
    "commands": [
      {
        "command": "mcpServers.startServer",
        "title": "Start Server",
        "category": "MCP Servers"
      },
      {
        "command": "mcpServers.stopServer",
        "title": "Stop Server",
        "category": "MCP Servers"
      },
      {
        "command": "mcpServers.restartServer",
        "title": "Restart Server",
        "category": "MCP Servers"
      },
      {
        "command": "mcpServers.copyServerUrl",
        "title": "Copy Server URL",
        "category": "MCP Servers"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcpServers",
          "title": "MCP Servers",
          "icon": "$(server)"
        }
      ]
    },
    "views": {
      "mcpServers": [
        {
          "id": "mcpServers",
          "name": "MCP Servers"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "dependencies": {
    "@mcp-servers/server-git": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vscode/vsce": "^3.2.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
