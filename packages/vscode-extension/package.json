{
  "name": "mcp-servers",
  "displayName": "MCP Servers",
  "description": "Runs Model Context Protocol servers (Git, and CodeRAG semantic search where supported) inside VS Code, bound to loopback and protected by a bearer token.",
  "version": "0.1.0",
  "publisher": "SaileshBellamkonda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaileshBellamkonda/mcp-servers.git",
    "directory": "packages/vscode-extension"
  },
  "homepage": "https://github.com/SaileshBellamkonda/mcp-servers#readme",
  "bugs": {
    "url": "https://github.com/SaileshBellamkonda/mcp-servers/issues"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "git",
    "claude"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22.16"
  },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configuration": {
      "title": "MCP Servers",
      "properties": {
        "mcpServers.git.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the Git MCP server automatically when VS Code opens with a workspace folder, and when a folder is opened later."
        },
        "mcpServers.git.port": {
          "type": "integer",
          "default": 3000,
          "description": "Port of the Git MCP server on 127.0.0.1. Changing it restarts a running server. 0 picks a free port (the URL then changes on every start).",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "commands": [
      {
        "command": "mcpServers.startServer",
        "title": "Start Server",
        "category": "MCP Servers",
        "icon": "$(play)"
      },
      {
        "command": "mcpServers.stopServer",
        "title": "Stop Server",
        "category": "MCP Servers",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mcpServers.restartServer",
        "title": "Restart Server",
        "category": "MCP Servers",
        "icon": "$(debug-restart)"
      },
      {
        "command": "mcpServers.copyServerUrl",
        "title": "Copy Server URL",
        "category": "MCP Servers",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mcpServers.startServer",
          "when": "mcpServers.anyStartable"
        },
        {
          "command": "mcpServers.stopServer",
          "when": "mcpServers.anyRunning"
        },
        {
          "command": "mcpServers.restartServer",
          "when": "mcpServers.anyRunning"
        },
        {
          "command": "mcpServers.copyServerUrl",
          "when": "mcpServers.anyRunning"
        }
      ],
      "view/item/context": [
        {
          "command": "mcpServers.startServer",
          "when": "view == mcpServers && (viewItem == server.stopped || viewItem == server.error)",
          "group": "inline@1"
        },
        {
          "command": "mcpServers.stopServer",
          "when": "view == mcpServers && viewItem == server.running",
          "group": "inline@2"
        },
        {
          "command": "mcpServers.restartServer",
          "when": "view == mcpServers && viewItem == server.running",
          "group": "inline@3"
        },
        {
          "command": "mcpServers.startServer",
          "when": "view == mcpServers && (viewItem == server.stopped || viewItem == server.error)",
          "group": "1_lifecycle@1"
        },
        {
          "command": "mcpServers.stopServer",
          "when": "view == mcpServers && viewItem == server.running",
          "group": "1_lifecycle@2"
        },
        {
          "command": "mcpServers.restartServer",
          "when": "view == mcpServers && viewItem == server.running",
          "group": "1_lifecycle@3"
        },
        {
          "command": "mcpServers.copyServerUrl",
          "when": "view == mcpServers && viewItem == server.running",
          "group": "2_copy@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcpServers",
          "title": "MCP Servers",
          "icon": "$(server)"
        }
      ]
    },
    "views": {
      "mcpServers": [
        {
          "id": "mcpServers",
          "name": "MCP Servers"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ../../scripts/bundle-extension.mjs .",
    "stage:native": "node ../../scripts/stage-native.mjs",
    "package": "node ../../scripts/package-extension.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@mcp-servers/server-coderag": "workspace:*",
    "@mcp-servers/server-git": "workspace:*",
    "@types/node": "catalog:",
    "@types/vscode": "1.101.0",
    "@vitest/coverage-v8": "catalog:",
    "@vscode/vsce": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
