{
  "name": "@mcp-servers/server-coderag",
  "version": "1.0.0",
  "description": "CodeRAG MCP Server - Semantic search over code and docs via OpenAI-compatible embeddings",
  "type": "module",
  "main": "./dist/standalone.js",
  "types": "./dist/standalone.d.ts",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/standalone.d.ts",
        "default": "./dist/standalone.js"
      }
    },
    "./embedded": {
      "import": {
        "types": "./dist/embedded.d.ts",
        "default": "./dist/embedded.js"
      }
    }
  },
  "bin": {
    "coderag-mcp-server": "./dist/standalone.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/standalone.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": ["mcp", "rag", "embeddings", "semantic-search", "model-context-protocol"],
  "author": "Development Team",
  "license": "MIT",
  "dependencies": {
    "@cfworker/json-schema": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@modelcontextprotocol/hono": "catalog:",
    "@hono/node-server": "catalog:",
    "hono": "catalog:",
    "better-sqlite3": "catalog:",
    "sqlite-vec": "catalog:",
    "tree-sitter": "catalog:",
    "tree-sitter-typescript": "catalog:",
    "tree-sitter-javascript": "catalog:",
    "tree-sitter-python": "catalog:",
    "tree-sitter-go": "catalog:",
    "tree-sitter-rust": "catalog:",
    "tree-sitter-php": "catalog:",
    "tree-sitter-java": "catalog:",
    "tree-sitter-c-sharp": "catalog:",
    "tree-sitter-cpp": "catalog:",
    "tree-sitter-c": "catalog:",
    "tree-sitter-ruby": "catalog:",
    "tree-sitter-bash": "catalog:",
    "gray-matter": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@types/vscode": "*"
  },
  "peerDependenciesMeta": {
    "@types/vscode": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
