{
  "name": "@mcp-servers/server-coderag",
  "version": "1.0.0",
  "description": "CodeRAG MCP Server - Semantic search over code and docs via OpenAI-compatible embeddings",
  "type": "module",
  "main": "./dist/standalone.js",
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./dist/standalone.js",
    "./embedded": {
      "@mcp-servers/source": "./src/embedded.ts",
      "default": "./dist/embedded.js"
    }
  },
  "bin": {
    "coderag-mcp-server": "./dist/standalone.js"
  },
  "scripts": {
    "bundle": "tsdown",
    "build": "pnpm run clean && pnpm run bundle",
    "dev": "node --conditions=@mcp-servers/source src/standalone.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "node --conditions=@mcp-servers/source scripts/bench-search.ts",
    "eval": "node --conditions=@mcp-servers/source scripts/retrieval-eval.ts",
    "eval:relations": "node --conditions=@mcp-servers/source scripts/relations-eval.ts",
    "bench:repo": "node --conditions=@mcp-servers/source scripts/bench-repo.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": ["mcp", "rag", "embeddings", "semantic-search", "model-context-protocol"],
  "author": "Development Team",
  "license": "MIT",
  "dependencies": {
    "@cfworker/json-schema": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@modelcontextprotocol/hono": "catalog:",
    "@hono/node-server": "catalog:",
    "hono": "catalog:",
    "sqlite-vec": "catalog:",
    "tree-sitter": "catalog:",
    "tree-sitter-typescript": "catalog:",
    "tree-sitter-javascript": "catalog:",
    "tree-sitter-python": "catalog:",
    "tree-sitter-go": "catalog:",
    "tree-sitter-rust": "catalog:",
    "tree-sitter-php": "catalog:",
    "tree-sitter-java": "catalog:",
    "tree-sitter-c-sharp": "catalog:",
    "tree-sitter-cpp": "catalog:",
    "tree-sitter-c": "catalog:",
    "tree-sitter-ruby": "catalog:",
    "tree-sitter-bash": "catalog:",
    "gray-matter": "catalog:",
    "micromatch": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mcp-servers/common": "workspace:*",
    "@mcp-servers/http-host": "workspace:*",
    "@tsconfig/node24": "catalog:",
    "@types/micromatch": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "node-gyp": "catalog:"
  },
  "peerDependencies": {
    "@types/vscode": "*"
  },
  "peerDependenciesMeta": {
    "@types/vscode": {
      "optional": true
    }
  }
}
