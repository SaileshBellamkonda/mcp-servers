{
  "name": "@mcp-servers/server-git",
  "version": "1.0.0",
  "description": "Git MCP Server - Safe, controlled Git operations via Model Context Protocol",
  "type": "module",
  "main": "./dist/standalone.js",
  "types": "./dist/standalone.d.ts",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/standalone.d.ts",
        "default": "./dist/standalone.js"
      }
    },
    "./embedded": {
      "import": {
        "types": "./dist/embedded.d.ts",
        "default": "./dist/embedded.js"
      }
    }
  },
  "bin": {
    "git-mcp-server": "./dist/standalone.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/standalone.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "git",
    "model-context-protocol",
    "vscode"
  ],
  "author": "Development Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@modelcontextprotocol/express": "catalog:",
    "which": "^6.0.1",
    "zod": "^3.22.0",
    "express": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "^4.7.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@types/vscode": "*"
  },
  "peerDependenciesMeta": {
    "@types/vscode": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
