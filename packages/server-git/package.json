{
  "name": "@mcp-servers/server-git",
  "version": "1.0.0",
  "description": "Git MCP Server - Safe, controlled Git operations via Model Context Protocol",
  "type": "module",
  "main": "./dist/standalone.js",
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./dist/standalone.js",
    "./embedded": {
      "@mcp-servers/source": "./src/embedded.ts",
      "default": "./dist/embedded.js"
    }
  },
  "bin": {
    "git-mcp-server": "./dist/standalone.js"
  },
  "scripts": {
    "bundle": "tsdown",
    "build": "pnpm run clean && pnpm run bundle",
    "dev": "node --conditions=@mcp-servers/source src/standalone.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "git",
    "model-context-protocol",
    "vscode"
  ],
  "author": "Development Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@modelcontextprotocol/hono": "catalog:",
    "@hono/node-server": "catalog:",
    "hono": "catalog:",
    "which": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mcp-servers/common": "workspace:*",
    "@mcp-servers/http-host": "workspace:*",
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "@types/which": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@types/vscode": "*"
  },
  "peerDependenciesMeta": {
    "@types/vscode": {
      "optional": true
    }
  }
}
