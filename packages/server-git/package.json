{
  "name": "@mcp-servers/server-git",
  "version": "1.0.0",
  "description": "Git MCP Server - Safe, controlled Git operations via Model Context Protocol",
  "type": "module",
  "main": "./dist/standalone.js",
  "types": "./dist/standalone.d.ts",
  "files": ["dist", "!dist/.tsbuildinfo", "README.md"],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/standalone.d.ts",
        "default": "./dist/standalone.js"
      }
    },
    "./embedded": {
      "import": {
        "types": "./dist/embedded.d.ts",
        "default": "./dist/embedded.js"
      }
    }
  },
  "bin": {
    "git-mcp-server": "./dist/standalone.js"
  },
  "scripts": {
    "build": "pnpm run clean && node ../../scripts/bundle-server.mjs . && tsc -b tsconfig.build.json",
    "dev": "tsx --conditions=@mcp-servers/source src/standalone.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "git",
    "model-context-protocol",
    "vscode"
  ],
  "author": "Development Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@modelcontextprotocol/hono": "catalog:",
    "@hono/node-server": "catalog:",
    "hono": "catalog:",
    "which": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mcp-servers/common": "workspace:*",
    "@mcp-servers/http-host": "workspace:*",
    "esbuild": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@types/which": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@types/vscode": "*"
  },
  "peerDependenciesMeta": {
    "@types/vscode": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
