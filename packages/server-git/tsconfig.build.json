{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "customConditions": [],
    "outDir": "dist",
    "rootDir": "src",
    "composite": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ],
  "references": [
    {
      "path": "../shared/common/tsconfig.build.json"
    },
    {
      "path": "../shared/http-host/tsconfig.build.json"
    }
  ]
}
